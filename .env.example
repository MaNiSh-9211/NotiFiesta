# NotiFiesta/.env.example - template (committed). NO real values.
# Frontend (Vite - injected at build time)
VITE_FIREBASE_API_KEY=CHANGE_ME_FIREBASE_API_KEY
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id

# Backend
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/notifiesta?retryWrites=true&w=majority
JWT_SECRET=CHANGE_ME_long_random_secret
PORT=5000
